": null, "next_id": 0}, {"id": 88, "group_id": 52, "comment": "Oh, it's you!", "voice": "2114_VOICE_BULIVISIT_NORMAL_2", "weight": 50, "name": null, "next_id": 0}, {"id": 89, "group_id": 52, "comment": "Come, your audience awaits!", "voice": "2114_VOICE_BULIVISIT_NORMAL_3", "weight": 50, "name": null, "next_id": 0}, {"id": 90, "group_id": 52, "comment": "We've been waiting! Come, let me see your skill.", "voice": "2114_VOICE_BULIVISIT_RARE_1", "weight": 10, "name": null, "next_id": 0}, {"id": 91, "group_id": 52, "comment": "Heehee, I knew... It was only a matter of time before you returned.", "voice": "2114_VOICE_BULIVISIT_RARE_2", "weight": 10, "name": null, "next_id": 0}, {"id": 92, "group_id": 53, "comment": "Battle knows no end!", "voice": "2114_VOICE_BULIVISIT_NEW_1", "weight": 50, "name": null, "next_id": 0}, {"id": 93, "group_id": 53, "comment": "Your eyes turn ever upward, don't they?", "voice": "2114_VOICE_BULIVISIT_NEW_2", "weight": 50, "name": null, "next_id": 0}, {"id": 94, "group_id": 54, "comment": "Here's your current record.", "voice": "2114_VOICE_BUIL_TOP_1", "weight": 100, "name": null, "next_id": 0}, {"id": 95, "group_id": 55, "comment": "Rewards are this way.", "voice": "2114_VOICE_BUIL_TOP_2", "weight": 100, "name": null, "next_id": 0}, {"id": 96, "group_id": 56, "comment": "Give us a real show!", "voice": "2114_VOICE_BUIL_TOP_3", "weight": 100, "name": null, "next_id": 0}, {"id": 97, "group_id": 57, "comment": "Congratulations.", "voice": "2114_VOICE_BUIL_FUNCTION_1", "weight": 50, "name": null, "next_id": 0}, {"id": 99, "group_id": 58, "comment": "I look forward to what comes next...", "voice": "2114_VOICE_BUIL_FUNCTION_2", "weight": 50, "name": null, "next_id": 0}, {"id": 101, "group_id": 59, "comment": "Congratulations!♪", "voice": "2114_VOICE_BUIL_FUNCTION_3", "weight": 50, "name": null, "next_id": 0}, {"id": 102, "group_id": 59, "comment": "Keep moving upward...", "voice": "2114_VOICE_BUIL_FUNCTION_4", "weight": 50, "name": null, "next_id"