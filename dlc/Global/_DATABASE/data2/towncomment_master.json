t_id": 0}, {"id": 117, "group_id": 65, "comment": "There's a pretty big job just come in, you interested?", "voice": "2111_VOICE_BULIVISIT_NEW_2", "weight": 50, "name": null, "next_id": 0}, {"id": 118, "group_id": 66, "comment": "This is what we've got.", "voice": "2111_VOICE_BUIL_TOP_1", "weight": 50, "name": null, "next_id": 0}, {"id": 120, "group_id": 67, "comment": "This is it.", "voice": "2111_VOICE_BUIL_TOP_2", "weight": 50, "name": null, "next_id": 0}, {"id": 122, "group_id": 68, "comment": "Are you feeling that one?", "voice": "2111_VOICE_BUIL_TOP_3", "weight": 50, "name": null, "next_id": 0}, {"id": 124, "group_id": 69, "comment": "Go get it done!", "voice": "2111_VOICE_BUIL_FUNCTION_1", "weight": 100, "name": null, "next_id": 0}, {"id": 125, "group_id": 70, "comment": "Don't get cocky, OK?", "voice": "2111_VOICE_BUIL_FUNCTION_2", "weight": 100, "name": null, "next_id": 0}, {"id": 126, "group_id": 71, "comment": "Keep your head on.", "voice": "2111_VOICE_BUIL_FUNCTION_3", "weight": 100, "name": null, "next_id": 0}, {"id": 127, "group_id": 72, "comment": "Gahahaha, no challenge there, right?", "voice": "2111_VOICE_BUIL_FUNCTION_4", "weight": 100, "name": null, "next_id": 0}, {"id": 128, "group_id": 73, "comment": "Oh, nice work there! I think you might be able to handle more...", "voice": "2111_VOICE_BUIL_FUNCTION_5", "weight": 100, "name": null, "next_id": 0}, {"id": 129, "group_id": 74, "comment": "No complaints here. I'll have more later!", "voice": "2111_VOICE_BUIL_FUNCTION_6", "weight": 100, "name": null, "next_id": 0}, {"id": 130, "group_id": 75, "comment": "Hmph, OK then.", "voice": "2111_VOICE_BUIL_FUNCTION_7", "weight": 50, "name": null, "next_id": 0}, {"id": 131, "group_id": 75, "comment": "Oh, for crying out loud...", "voice": "2111_VOICE_BUIL_FUNCTION_8", "weight": 50, "name": null, "next_id": 0}, {"id": 132, "group_id": 76, "comment": "See you later.", "voice": "2111_VOICE_BUILLEAVE_01", "weight": 50, "name": null, "next_id": 0}, {"id": 133, "group_id": 76, "comment": "Don't forget your training!", "voice": "2111_VOICE_BUILLEAVE_02", "weight": 50, "name": null, "next_id": 0}, {"id": 134, "group_id": 76, "comment": "Good job.", "voice": "2111_VOICE_BUILLEAVE_03", "weight": 50, "name": null, "next_id": 0}, {"id": 135, "group_id": 77, "comment": "OK then, now maybe a drink? Agh, it was a joke, just a joke! So, what do you want?", "voice": "2111_VOICE_BUILLLEAVEALONE", "weight": 100, "name": null, "next_id": 0}, {"id": 136, "group_id": 78, "comment": "Welcome...", "voice": "2116_VOICE_BULIVISIT_NORMAL_1", "weight": 50, "name": null, "next_id": 0}, {"id": 137, "group_id": 78, "comment": "What would you like?", "voice": "2116_VOICE_BULIVISIT_NORMAL_2", "weight": 50, "name": null, "next_id": 0}, {"id": 138, "group_id": 78, "comment": "What is your desire?", "voice": "2116_VOICE_BULIVISIT_NORMAL_4", "weight": 50, "name": null, "next_id": 0}, {"id": 139, "group_id": 78, "comment": "Ah, and here you are again...", "voice": "2116_VOICE_BULIVISIT_NORMAL_3", "weight": 50, "name": null, "next_id": 0}, {"id": 140, "group_id": 78, "comment": "Very good...yes, take your time.", "voice": "2116_VOICE_BULIVISIT_RARE_1", "weight": 10, "name": null, "next_id": 0}, {"id": 141, "group_id": 78, "comment": "Ah, I was just putting on\nthe kettle. Would you \nlike some?", "voice": "2116_VOICE_BULIVISIT_RARE_2", "weight": 10, "name": null, "next_id": 0}, {"id": 142, "group_id": 79, "comment": "Ahhh...It's you.", "voice": "2116_VOICE_BULIVISIT_NEW_1", "weight": 50, "name": null, "next_id": 0}, {"id": 143, "group_id": 79, "comment": "Have you come to see me?", "voice": "2116_VOICE_BULIVISIT_NEW_2", "weight": 50, "name": null, "next_id": 0}, {"id": 144, "group_id": 80, "comment": "Now, just relax...", "voice": "2116_VOICE_BUIL_TOP_1", "weight": 50, "name": null, "next_id": 0}, {"id": 146, "group_id": 81, "comment": "I won't say no...", "voice": "2116_VOICE_BUIL_TOP_2", "weight": 50, "name": null, "next_id": 0}, {"id": 148, "group_id": 82, "comment": "I'll gladly take it off your hands.", "voice": "2116_VOICE_BUIL_TOP_3", "weight": 50, "name": null, "next_id": 0}, {"id": 150, "group_id": 83, "comment": "Is that what you want to sell?", "voice": "2116_VOICE_BUIL_TOP_4", "weight": 50, "name": null, "next_id": 0}, {"id": 152, "group_id": 84, "comment": "You have good taste.", "voice": "2116_VOICE_BUIL_FUNCTION_1", "weight": 50, "name": null, "next_id": 0}, {"id": 154, "group_id": 85, "comment": "Well, let's get started...", "voice": "2116_VOICE_BUIL_FUNCTION_2_01", "weight": 50, "name": null, "next_id": 0}, {"id": 155, "group_id": 85, "comment": "Don't get carried away.", "voice": "2116_VOICE_BUIL_FUNCTION_2_02", "weight": 50, "name": null, "next_id": 0}, {"id": 156, "group_id": 86, "comment": "A new spirit...", "voice": "2116_VOICE_BUIL_FUNCTION_3", "weight": 50, "name": null, "next_id": 0}, {"id": 158, "group_id": 87, "comment": "That's no mere tool!", "voice": "2116_VOICE_BUIL_FUNCTION_4", "weight": 50, "name": null, "next_id": 0}, {"id": 160, "group_id": 88, "comment": "How rare!", "voice": "2116_VOICE_BUIL_FUNCTION_5", "weight": 50, "name": null, "next_id": 0}, {"id": 162, "group_id": 92, "comment": "The powers resisted, perhaps...", "voice": "2116_VOICE_BUIL_FUNCTION_6", "weight": 50, "name": null, "next_id": 0}, {"id": 164, "group_id": 89, "comment": "Heehee...thank you.", "voice": "2116_VOICE_BUIL_FUNCTION_7", "weight": 50, "name": null, "next_id": 0}, {"id": 167, "group_id": 90, "comment": "You're welcome any time.", "voice": "2116_VOICE_BUILLEAVE_01", "weight": 50, "name": null, "next_id": 0}, {"id": 168, "group_id": 90, "comment": "Let's do meet again!", "voice": "2116_VOICE_BUILLEAVE_02", "weight": 50, "name": null, "next_id": 0}, {"id": 169, "group_id": 90, "comment": "Even if you only come to see me...", "voice": "2116_VOICE_BUILLEAVE_03", "weight": 50, "name": null, "next_id": 0}, {"id": 170, "group_id": 91, "comment": "I'm taking it easy today. Oh, because it's just us two?", "voice": "2116_VOICE_BUILLLEAVEALONE", "weight": 100, "name": null, "next_id": 0}, {"id": 171, "group_id": 93, "comment": "Hello, the library is open.", "voice": "2117_VOICE_BULIVISIT_CLOSE_1", "weight": 100, "name": "Serah", "next_id": 0}, {"id": 172, "group_id": 93, "comment": "Welcome, the Professor is out right now.", "voice": "2117_VOICE_BULIVISIT_CLOSE_2", "weight": 100, "name": "Serah", "next_id": 0}, {"id": 173, "group_id": 93, "comment": "Oh yes? What can I do for you?", "voice": "2117_VOICE_BULIVISIT_CLOSE_3", "weight": 100, "name": "Serah", "next_id": 0}, {"id": 174, "group_id": 93, "comment": "The information about the monsters of the Mines are all in the library.", "voice": "2117_VOICE_BULIVISIT_CLOSE_4", "weight": 100, "name": "Serah", "next_id": 0}, {"id": 175, "group_id": 93, "comment": "Did you come to meet me?", "voice": "2117_VOICE_BULIVISIT_CLOSE_5", "weight": 100, "name": "Serah", "next_id": 0}, {"id": 176, "group_id": 94, "comment": "The tunnels are complicated, and you'll easily get lost.\nBe careful.", "voice": "2117_VOICE_BULIVISIT_OPEN_ARCANA_2", "weight": 100, "name": "Arcana", "next_id": 177}, {"id": 177, "group_id": 94, "comment": "The Professor himself often gets lost, too.", "voice": "2117_VOICE_BULIVISIT_OPEN_SERA_2", "weight": 0, "name": "Serah", "next_id": 0}, {"id": 178, "group_id": 94, "comment": "Dangerous things are to happen when you're mining.\nDon't lower your guard!", "voice": "2117_VOICE_BULIVISIT_OPEN_ARCANA_3", "weight": 100, "name": "Arcana", "next_id": 179}, {"id": 179, "group_id": 94, "comment": "Look who's talking...", "voice": "2117_VOICE_BULIVISIT_OPEN_SERA_3", "weight": 0, "name": "Serah", "next_id": 0}, {"id": 180, "group_id": 95, "comment": "Heading back home? See you soon!", "voice": "2117_VOICE_BUILLEAVE_1", "weight": 100, "name": "Serah", "next_id": 0}, {"id": 181, "group_id": 95, "comment": "Nice work! See you!", "voice": "2117_VOICE_BUILLEAVE_2", "weight": 100, "name": "Serah", "next_id": 0}, {"id": 182, "group_id": 96, "comment": "Heading back home? See you soon!", "voice": "2117_VOICE_BUILLEAVE_1", "weight": 100, "name": "Serah", "next_id": 0}, {"id": 183, "group_id": 96, "comment": "Nice work! See you!", "voice": "2117_VOICE_BUILLEAVE_2", "weight": 100, "name": "Serah", "next_id": 0}, {"id": 184, "group_id": 96, "comment": "Great work.", "voice": "2117_VOICE_BUILLEAVE_3", "weight": 100, "name": "Arcana", "next_id": 0}, {"id": 185, "group_id": 97, "comment": "There you are.\nHave some snacks, if you\ncan pay for them.", "voice": "2392_VOICE_FREE_A", "weight": 100, "name": null, "next_id": 0}, {"id": 186, "group_id": 97, "comment": "What are we making today?", "voice": "2392_VOICE_FREE_B", "weight": 100, "name": null, "next_id": 0}, {"id": 187, "group_id": 97, "comment": "I was just about to get bored. Take a seat.", "voice": "2392_VOICE_FREE_C", "weight": 100, "name": null, "next_id": 0}, {"id": 188, "group_id": 97, "comment": "Once is enough to get you hooked, eh?", "voice": "2392_VOICE_FREE_D", "weight": 100, "name": null, "next_id": 0}, {"id": 190, "group_id": 98, "comment": "You came empty-handed?\nWhere's your sense of etiquette?", "voice": "2392_VOICE_FREE_E", "weight": 100, "name": null, "next_id": 0}, {"id": 191, "group_id": 99, "comment": "What are we making today?", "voice": "2392_VOICE_FREE_B", "weight": 100, "name": null, "next_id": 0}, {"id": 192, "group_id": 100, "comment": "Sorry, you need to prove yourself in Grand Crusade first.", "voice": null, "weight": 100, "name": null, "next_id": 0}, {"id": 193, "group_id": 101, "comment": "Here's a complete catalog of Fusion Equips. I'll give you a special peek.", "voice": null, "weight": 100, "name": null, "next_id": 0}]