[{"id": 1001, "name": "召喚道の第一歩", "difficulty": 1, "requirement_type": 10, "requirement_value_1": 0, "requirement_value_2": 1, "requirement_description": "ユニットを強化する", "description": "新米召喚士よ！\r\n基礎をおろそかにするとは嘆かわしいぞ！\r\n仕方がない、まずはワシが教えてやろう！\r\n依頼主：謎のおじいさん", "present_type": 17, "present_id": 1, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1002, "name": "武具の心得", "difficulty": 1, "requirement_type": 2, "requirement_value_1": 0, "requirement_value_2": 1, "requirement_description": "装備を強化する", "description": "ったく、新米冒険者のケアも楽じゃねえ。\r\n最初はギルドが支援してやるから\r\nまともな装備で冒険に出ろよ！\r\n依頼主：ギルドマスターのガナン", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1003, "name": "レイグラード支部", "difficulty": 1, "requirement_type": 4, "requirement_value_1": 100062025, "requirement_value_2": 1, "requirement_description": "キングレキュオンを1体討伐", "description": "夢や憧れだけじゃ仕事は務まらねえ。\r\nまずは頼まれた仕事をこなす。\r\n話はそれからだ！\r\n依頼主：ギルドマスターのガナン\r\nエリア：イスリーダ帝国\r\nクエスト：アグラナ溶岩洞「旅の始まり」", "present_type": 5, "present_id": 895205, "present_value": 5, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1004, "name": "ゴブル退治", "difficulty": 1, "requirement_type": 4, "requirement_value_1": 100161030, "requirement_value_2": 5, "requirement_description": "ゴブルを5体討伐", "description": "アグラナ溶岩洞のゴブル退治を頼む。\r\n世のため人のために働くのは\r\n冒険者の基本の仕事だぞ！\r\n依頼主：ギルドマスターのガナン\r\nエリア：イスリーダ帝国\r\nダンジョン：アグラナ溶岩洞", "present_type": 17, "present_id": 1, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1005, "name": "溶岩洞の噂", "difficulty": 1, "requirement_type": 7, "requirement_value_1": 100711, "requirement_value_2": 10, "requirement_description": "炎の鉱石を10個納品", "description": "『炎の鉱石』のいい産地が見つかった。\r\n噂が広まって取り尽くされる前に\r\n確保しておきたいからよろしく頼むぜ。\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1006, "name": "少女の想い", "difficulty": 1, "requirement_type": 6, "requirement_value_1": 1020, "requirement_value_2": 1, "requirement_description": "シーフードスープを1個納品", "description": "リブナルド雪原に\r\n素敵なスープ料理があるって聞いたの。\r\nお世話になった人に食べさせてあげたいな…\r\n依頼主：シルフィ", "present_type": 17, "present_id": 1, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1007, "name": "森の名産", "difficulty": 1, "requirement_type": 7, "requirement_value_1": 100913, "requirement_value_2": 10, "requirement_description": "樹の鉱石を10個納品", "description": "森といえばやっぱり『樹の鉱石』だよな。\r\n採れそうな場所の目星はついてるんだろう？\r\n今回もよろしく頼むぜ。\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1008, "name": "遺跡の守護者", "difficulty": 1, "requirement_type": 4, "requirement_value_1": 100131070, "requirement_value_2": 5, "requirement_description": "巨岩ドーマルを5体討伐", "description": "遺跡調査は冒険者のロマンだ。\r\nだが浮かれているとオダブツだぞ。\r\nなんせ…罠だらけなんだからな！\r\n依頼主：ギルドマスターのガナン\r\nエリア：イスリーダ帝国\r\nダンジョン：セルニア遺跡", "present_type": 17, "present_id": 1, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1009, "name": "怪しい輝き", "difficulty": 1, "requirement_type": 7, "requirement_value_1": 101115, "requirement_value_2": 10, "requirement_description": "闇の鉱石を10個納品", "description": "なんでも『闇の鉱石』を集めていた連中が\r\n戦いに敗れて、ブツが流出したらしい。\r\nとなりゃあ、やることは一つだよな？\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1101, "name": "戦え冒険者", "difficulty": 1, "requirement_type": 16, "requirement_value_1": 0, "requirement_value_2": 1, "requirement_description": "マルチモードを1回クリア", "description": "一人で戦ってばかりいねえか？\r\n時には競い、時には助け合う。\r\nそれもまた冒険者だぞ！\r\n依頼主：ギルドマスターのガナン", "present_type": 11, "present_id": 0, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1102, "name": "騎士団員の想い１", "difficulty": 1, "requirement_type": 4, "requirement_value_1": 100171040, "requirement_value_2": 3, "requirement_description": "サーディンを3体討伐", "description": "なぜこのような忙しい時に現れるのだ！\r\n本来我々にかかればサーディンなど！\r\nせめて我の体が万全であれば…\r\n依頼主：リーベルト\r\nエリア：イスリーダ帝国\r\nクエスト：リブナルド雪原", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1103, "name": "騎士団員の想い２", "difficulty": 2, "requirement_type": 4, "requirement_value_1": 100201080, "requirement_value_2": 5, "requirement_description": "スケルトンを5体討伐", "description": "誇り高きイスリーダ帝国軍は\r\n本来冒険者などに依頼をする立場ではない。\r\nしかし、それと民の安寧は別なのだ…\r\n依頼主：リーベルト\r\nエリア：イスリーダ帝国\r\nクエスト：ゴルドア要塞", "present_type": 5, "present_id": 895205, "present_value": 5, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1104, "name": "少年冒険者の夜明け", "difficulty": 1, "requirement_type": 7, "requirement_value_1": 101014, "requirement_value_2": 8, "requirement_description": "光の鉱石を8個納品", "description": "弱い自分は嫌だ！\r\n僕は戦って強くなる！\r\nでもそのためには準備が必要なんだ。\r\n依頼主：リュート", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1105, "name": "少女料理人の夜明け？", "difficulty": 1, "requirement_type": 6, "requirement_value_1": 1007, "requirement_value_2": 3, "requirement_description": "魚の切り身を3個納品", "description": "冒険者になるなんて…\r\nどうしてわざわざ危ない事をするの？\r\n私がしっかりしなくちゃ！\r\n依頼主：シルフィ", "present_type": 17, "present_id": 1, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1106, "name": "英雄達の足跡", "difficulty": 1, "requirement_type": 8, "requirement_value_1": 0, "requirement_value_2": 1, "requirement_description": "ユニットを進化させる", "description": "新米召喚士よ、満足するにはまだ早いわ！\r\n志が低くて嘆かわしいぞ…\r\n仕方がない、特別にワシが導いてやろう！\r\n依頼主：謎のおじいさん", "present_type": 11, "present_id": 0, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1107, "name": "毒を甘く見るな", "difficulty": 2, "requirement_type": 15, "requirement_value_1": 2, "requirement_value_2": 3, "requirement_description": "解毒の指輪をLv3まで強化する", "description": "毒対策は万全か！？\r\n毒ってのは甘く見ると痛い目に遭う。\r\n今のうちに対策しておけ！\r\n依頼主：ギルドマスターのガナン", "present_type": 17, "present_id": 3, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1108, "name": "海岸のお土産", "difficulty": 2, "requirement_type": 7, "requirement_value_1": 100812, "requirement_value_2": 10, "requirement_description": "水の鉱石を10個納品", "description": "海岸まで足を伸ばしたんだって？\r\n水くせえな、なんで早く言わねえんだ！\r\n次は土産を頼んだぜ。\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1109, "name": "遊歩道の魔物", "difficulty": 2, "requirement_type": 4, "requirement_value_1": 100181110, "requirement_value_2": 5, "requirement_description": "コロックを5体討伐", "description": "近々コロック遊歩道に行きたいと\r\n思っているんだが…\r\n最近コロックが増えて危険らしいんだ。\r\n依頼主：アルベルト\r\nエリア：グラメニア共和国\r\nダンジョン：コロック遊歩道", "present_type": 17, "present_id": 1, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1110, "name": "活力呼ぶ石", "difficulty": 2, "requirement_type": 7, "requirement_value_1": 101014, "requirement_value_2": 10, "requirement_description": "光の鉱石を10個納品", "description": "なんだか気分が沈んで仕方ねえな…\r\n眺めてて元気になる商品でもないもんか？\r\nそうだな、例えば『光の鉱石』とかよ！\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1111, "name": "呪解の必需品", "difficulty": 2, "requirement_type": 6, "requirement_value_1": 1027, "requirement_value_2": 2, "requirement_description": "黒のキノコを2個納品", "description": "我々、神官にとってログーノ湿地の\r\n『黒のキノコ』は必需品なのです。\r\n聖水だけが呪解の術ではないのですからね。\r\n依頼主：アンドレイ", "present_type": 17, "present_id": 1, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1201, "name": "ガナンの気苦労", "difficulty": 2, "requirement_type": 4, "requirement_value_1": 100352170, "requirement_value_2": 3, "requirement_description": "ワイバーンを3体討伐", "description": "騎士団から依頼が入っている。\r\nワイバーンの討伐だな。\r\n迅速に対応出来る奴を探している！\r\n依頼主：ギルドマスターのガナン\r\nエリア：ファメル王国西部\r\nダンジョン：ヴァルダンの魔窟", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1202, "name": "冒険者の心得", "difficulty": 1, "requirement_type": 5, "requirement_value_1": 10104, "requirement_value_2": 1, "requirement_description": "クエスト「小さな冒険者」を1回クリア", "description": "お兄ちゃんさえいれば\r\nどんな冒険だって怖くない！\r\nよっし、次の冒険へ出発だ！\r\n依頼主：リュート\r\nエリア：イスリーダ帝国\r\nクエスト：イスリーダ平原「小さな冒険者」", "present_type": 11, "present_id": 0, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1203, "name": "商人の男１", "difficulty": 3, "requirement_type": 7, "requirement_value_1": 101115, "requirement_value_2": 10, "requirement_description": "闇の鉱石を10個納品", "description": "需要と供給ってのは面白い関係だ。\r\n必要な時に限って欲しい物が無え…\r\nだがな、そんな時こそ稼ぎ時ってもんよ。\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1204, "name": "少女の恩返し", "difficulty": 1, "requirement_type": 6, "requirement_value_1": 1020, "requirement_value_2": 3, "requirement_description": "シーフードスープを3個納品", "description": "おじいちゃん、おばあちゃん\r\nいつもありがとう。\r\n私にもささやかな恩返し…できるかな？\r\n依頼主：シルフィ", "present_type": 17, "present_id": 1, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1205, "name": "騎士の意地", "difficulty": 3, "requirement_type": 4, "requirement_value_1": 100112150, "requirement_value_2": 10, "requirement_description": "冥獣ギリウスを10体討伐", "description": "ファメル王国騎士の端くれとして…\r\nなんとしても冥獣ギリウスを討伐せねば！\r\nどうか、私に力を貸してほしい。\r\n依頼主：レイモンド\r\nエリア：ファメル王国西部\r\nダンジョン：ファメルロック", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1206, "name": "臆病な騎士", "difficulty": 3, "requirement_type": 4, "requirement_value_1": 100172150, "requirement_value_2": 10, "requirement_description": "サーディオンを10体討伐", "description": "無論この程度の任務は一人でも問題ない。\r\nだが、私は慎重派なのでな、同行を頼む。\r\n…断じて幽霊が怖いわけではないぞ？\r\n依頼主：レイモンド\r\nエリア：ファメル王国西部\r\nダンジョン：幽霊船", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1207, "name": "時間は待ってくれない", "difficulty": 3, "requirement_type": 15, "requirement_value_1": 12, "requirement_value_2": 3, "requirement_description": "疾風の額当てをLv3まで強化する", "description": "のんびり世界を見て回るのもいいが\r\n時間だけは待ってくれないのが世の常だ\r\n冒険者たる者、速度も肝要と知れ！\r\n依頼主：ギルドマスターのガナン", "present_type": 17, "present_id": 3, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1208, "name": "酒造りは命がけ", "difficulty": 3, "requirement_type": 6, "requirement_value_1": 1028, "requirement_value_2": 5, "requirement_description": "銀のライチを5個納品", "description": "旨い酒は飲みすぎると命を縮める\r\nだが、作る方だって命がけなんだぞ！\r\n光鳥の寝所なんて…二度と行きたくない…\r\n依頼主：ダン", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1209, "name": "背伸びする騎士", "difficulty": 3, "requirement_type": 4, "requirement_value_1": 100152170, "requirement_value_2": 10, "requirement_description": "ブラッディバットを10体討伐", "description": "ファメル王国の騎士たる者、\r\n死地へ飛び込まねばならぬ時もある。\r\nだが、貴殿が一緒ならば心強い。\r\n依頼主：レイモンド\r\nエリア：ファメル王国西部\r\nダンジョン：ヴァルダンの魔窟", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1301, "name": "遊歩道の旅１", "difficulty": 2, "requirement_type": 5, "requirement_value_1": 20306, "requirement_value_2": 1, "requirement_description": "クエスト「遊歩道の旅」を1回クリア", "description": "コロック遊歩道…\r\n俺はそこへ連れて行きたい人がいるんだ。\r\nよい旅になる事を願っているよ。\r\n依頼主：アルベルト\r\nエリア：グラメニア共和国\r\nクエスト：コロック遊歩道「遊歩道の旅」", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1302, "name": "遊歩道の旅２", "difficulty": 2, "requirement_type": 5, "requirement_value_1": 20307, "requirement_value_2": 1, "requirement_description": "クエスト「遊歩道の生態系」を1回クリア", "description": "コロック遊歩道…\r\n俺はそこへ連れて行きたい人がいるんだ。\r\nよい旅になる事を願っているよ。\r\n依頼主：アルベルト\r\nエリア：グラメニア共和国\r\nクエスト：コロック遊歩道「遊歩道の生態系」", "present_type": 5, "present_id": 898203, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1303, "name": "遊歩道の旅３", "difficulty": 3, "requirement_type": 5, "requirement_value_1": 20308, "requirement_value_2": 1, "requirement_description": "クエスト「旅の終わりに」を1回クリア", "description": "コロック遊歩道…\r\n俺はそこへ連れて行きたい人がいるんだ。\r\nよい旅になる事を願っているよ。\r\n依頼主：アルベルト\r\nエリア：グラメニア共和国\r\nクエスト：コロック遊歩道「旅の終わりに」", "present_type": 11, "present_id": 0, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1304, "name": "商人の男２", "difficulty": 4, "requirement_type": 7, "requirement_value_1": 101231, "requirement_value_2": 5, "requirement_description": "炎の結晶を5個納品", "description": "今この時期に『炎の結晶』を集めたい。\r\nそういうここぞって時の依頼に関しちゃ\r\n俺は人で判断する事にしている。\r\n依頼主：マッシュ", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1305, "name": "超兵器を止めろ", "difficulty": 2, "requirement_type": 4, "requirement_value_1": 100633215, "requirement_value_2": 1, "requirement_description": "機兵ヴァイドを1体討伐", "description": "騎士団から依頼が入っている。\r\n『機兵ヴァイド』の討伐だな。\r\n迅速に対応出来る奴を探している！\r\n依頼主：ギルドマスターのガナン\r\nエリア：ファメル王国東部\r\nクエスト：ノモリス洞庭湖「ノモリスの主」", "present_type": 17, "present_id": 3, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1306, "name": "酒場マスター１", "difficulty": 2, "requirement_type": 6, "requirement_value_1": 1017, "requirement_value_2": 5, "requirement_description": "ピラフを5個納品", "description": "ガナン、あんたのとこに一つ仕事を頼むよ。\r\nわたしの店に必要なもんさ。\r\nあんたにとっても悪い話じゃないだろう？\r\n依頼主：グローリア", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1307, "name": "私だって女の子", "difficulty": 4, "requirement_type": 6, "requirement_value_1": 1003, "requirement_value_2": 1, "requirement_description": "バターブリオッシュを1個納品", "description": "日々まじめに働いていると\r\n時には癒しが欲しくなるのです。\r\n甘い物の一つくらい良いですよね？\r\n依頼主：リーゼ", "present_type": 17, "present_id": 2, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1308, "name": "英雄達の限界は？", "difficulty": 3, "requirement_type": 9, "requirement_value_1": 0, "requirement_value_2": 1, "requirement_description": "ユニットを限界突破する", "description": "限界じゃと！？\r\n何をいっぱしの召喚士を気取っておるか！\r\nそんなもんはこうしてやるわ！\r\n依頼主：謎のおじいさん", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1309, "name": "装備はただの道具じゃない", "difficulty": 3, "requirement_type": 11, "requirement_value_1": 0, "requirement_value_2": 1, "requirement_description": "装備を限界突破する", "description": "多少は冒険者らしくなってきたじゃねえか。\r\nだがまだまだ基礎がわかっちゃいねえ。\r\nそんなお前にこの任務を与えよう。\r\n依頼主：ギルドマスターのガナン", "present_type": 17, "present_id": 3, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1310, "name": "騎士のやせ我慢", "difficulty": 4, "requirement_type": 4, "requirement_value_1": 100212210, "requirement_value_2": 15, "requirement_description": "グロノスを15体討伐", "description": "引かぬ、折れぬ、屈せぬ。\r\nこれぞ王国騎士の大原則！だが…\r\n「頼らぬ」という原則は無い、同行を頼む。\r\n依頼主：レイモンド\r\nエリア：ファメル王国東部\r\nダンジョン：モグロ砂海", "present_type": 17, "present_id": 1, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1311, "name": "備えあれば憂いなし", "difficulty": 4, "requirement_type": 15, "requirement_value_1": 16, "requirement_value_2": 3, "requirement_description": "ソウルリカバリーをLv3まで強化する", "description": "冒険者はいつでも身一つ、保険はない…\r\n常にその覚悟は必要だが、万が一の手段を\r\n用意しておくのも、冒険者の鉄則だぞ！\r\n依頼主：ギルドマスターのガナン", "present_type": 17, "present_id": 3, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1312, "name": "冒険者はお得意様", "difficulty": 4, "requirement_type": 7, "requirement_value_1": 101433, "requirement_value_2": 20, "requirement_description": "樹の結晶を20個納品", "description": "ずいぶんと遠出するようになったそうだな。\r\nその分じゃ、そろそろ『樹の結晶』にも\r\n出会った頃合いだろう？\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1313, "name": "騎士の出世", "difficulty": 4, "requirement_type": 4, "requirement_value_1": 100342210, "requirement_value_2": 15, "requirement_description": "オグロを15体討伐", "description": "ついに神々の遺跡探索を任されるとは…\r\nファメル王国の騎士として最高の誉れ！\r\nさあ、この名誉を分かち合おうじゃないか。\r\n依頼主：レイモンド\r\nエリア：ファメル王国東部\r\nダンジョン：レローク古代遺跡", "present_type": 17, "present_id": 1, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1314, "name": "少しならバレないさ", "difficulty": 4, "requirement_type": 7, "requirement_value_1": 101635, "requirement_value_2": 20, "requirement_description": "闇の結晶を20個納品", "description": "魔導要塞には『闇の結晶』が\r\n溜め込まれてるって噂があるんだ。\r\nちょっと位いただいたって構わんよな？\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1401, "name": "民思いの兵士１", "difficulty": 3, "requirement_type": 4, "requirement_value_1": 100564275, "requirement_value_2": 3, "requirement_description": "ダルギオン★4を3体討伐", "description": "モンスター達が活発だ…これは一体…\r\nいや、悩んでいる暇はない！\r\n民の生活がかかっているのだ！\r\n依頼主：リーベルト\r\nエリア：封魔域ゴルモレイ\r\nクエスト：オグローン火山「弾けるマグマ」", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1402, "name": "民思いの兵士２", "difficulty": 4, "requirement_type": 4, "requirement_value_1": 100503325, "requirement_value_2": 3, "requirement_description": "アフラドルを3体討伐", "description": "次から次へとモンスターの討伐任務が…\r\nここで後手に回るわけにはいかぬ！\r\n貴公の力を貸してくれ！\r\n依頼主：リーベルト\r\nエリア：封魔域ゴルモレイ\r\nクエスト：魔城ゴルモレイ「魔城への突入」", "present_type": 11, "present_id": 0, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1403, "name": "酒場マスター２", "difficulty": 3, "requirement_type": 6, "requirement_value_1": 1018, "requirement_value_2": 1, "requirement_description": "ミックスピラフを1個納品", "description": "ガナン、あんたのとこの若いの\r\n中々頼りになるじゃないか。\r\nまたお店のために一頑張りしてもらうよ\r\n依頼主：グローリア", "present_type": 17, "present_id": 3, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1404, "name": "あなたの知らない秘術", "difficulty": 3, "requirement_type": 7, "requirement_value_1": 101953, "requirement_value_2": 1, "requirement_description": "大樹の霊晄石を1個納品", "description": "研究は日々続くわ…\r\n目的が遂行されるまで、ずっとね。\r\nそうだわ…あの子にお願いしてみようかしら。\r\n依頼主：レム", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1405, "name": "勇気と商魂", "difficulty": 5, "requirement_type": 7, "requirement_value_1": 101231, "requirement_value_2": 20, "requirement_description": "炎の結晶を20個納品", "description": "オグローン火山にまで足を伸ばすとは…\r\nその勇気、恐れ入った！\r\nで、『炎の結晶』はどれくらい採れたんだ？\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1406, "name": "そのまま眠るよりは", "difficulty": 5, "requirement_type": 7, "requirement_value_1": 101332, "requirement_value_2": 20, "requirement_description": "水の結晶を20個納品", "description": "神殿から採集するのはマズいって？\r\n『水の結晶』だってそのまま眠るより\r\n使われた方が幸せってもんだ。\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1407, "name": "相容れない存在", "difficulty": 5, "requirement_type": 4, "requirement_value_1": 100282270, "requirement_value_2": 15, "requirement_description": "盗賊クロウを15体討伐", "description": "冒険者と盗賊は相容れないもんよ。\r\n当然だが許しちゃおけない存在だ。\r\n見つけたら強く灸をすえてやれ！\r\n依頼主：ギルドマスターのガナン\r\nエリア：封魔域ゴルモレイ\r\nダンジョン：エゴル大樹海", "present_type": 17, "present_id": 1, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1408, "name": "結晶、あと一種類", "difficulty": 5, "requirement_type": 7, "requirement_value_1": 101534, "requirement_value_2": 20, "requirement_description": "光の結晶を20個納品", "description": "足りないんだよ…あと一種類…\r\n俺とお前さんの関係だ、わかるよな？\r\nそうだ、『光の結晶』頼んだぞ！\r\n依頼主：マッシュ", "present_type": 17, "present_id": 2, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1409, "name": "決死の魔竜退治", "difficulty": 5, "requirement_type": 4, "requirement_value_1": 100353290, "requirement_value_2": 15, "requirement_description": "ファフニールを15体討伐", "description": "間違いなく激戦になるだろう…\r\nだが我々はなんとしても勝たねばならない。\r\n何も言わずに力を貸してくれ！\r\n依頼主：リーベルト\r\nエリア：封魔域ゴルモレイ\r\nダンジョン：黒門", "present_type": 17, "present_id": 1, "present_value": 3, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1410, "name": "神焔竜への挑戦", "difficulty": 3, "requirement_type": 5, "requirement_value_1": 993202, "requirement_value_2": 1, "requirement_description": "神焔竜の咆哮の上級をクリアする", "description": "封印域に眠るとされる神焔竜か…\r\n覚悟はできているようだな。\r\nならば何も言わねえ。帰ってこいよ。\r\n依頼主：ギルドマスターのガナン\r\n※マルチプレイはルーム作成者のみ達成可能", "present_type": 5, "present_id": 117141, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1411, "name": "冥蟲姫への挑戦", "difficulty": 3, "requirement_type": 5, "requirement_value_1": 993102, "requirement_value_2": 1, "requirement_description": "冥界の狩猟者の上級をクリアする", "description": "未知の存在に向かうその気持ち。\r\nそれがお前を前に進めるんだな。\r\n俺はお前を信じているぞ。\r\n依頼主：ギルドマスターのガナン\r\n※マルチプレイはルーム作成者のみ達成可能", "present_type": 5, "present_id": 117343, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1412, "name": "葬魂神への挑戦", "difficulty": 3, "requirement_type": 5, "requirement_value_1": 993002, "requirement_value_2": 1, "requirement_description": "黄昏に嗤う死神の上級をクリアする", "description": "自ら死神に会いに行くバカがいるとはな…\r\n冒険者の探究心は止められねーか。\r\nいいか、死ぬんじゃねえぞ。\r\n依頼主：ギルドマスターのガナン\r\n※マルチプレイはルーム作成者のみ達成可能", "present_type": 5, "present_id": 117242, "present_value": 1, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", "status": 1, "story": "0"}, {"id": 1501, "name": "パーティは突然に", "difficulty": 4, "requirement_type": 6, "requirement_value_1": 1006, "requirement_value_2": 3, "requirement_description": "ドラゴンステーキを3個納品", "description": "忙しい時って重なる物よね。\r\nでも私は諦めたくない…！\r\nそれには人の手助けが必要なのよ。\r\n依頼主：ソフィ", "present_type": 17, "present_id": 1, "present_value": 2, "custam_parameter": null, "start_at": "2015-09-10 15:14:11+09:00", "end_at": "2030-09-10 15:14:11+09:00", 