[{"id": 1, "group_id": 1, "comment": "おう、仕事か？", "voice": "2112_VOICE_BULIVISIT_NORMAL_1", "weight": 50, "name": null, "next_id": 0}, {"id": 2, "group_id": 1, "comment": "戦いにはいい武具が不可欠だ。", "voice": "2112_VOICE_BULIVISIT_NORMAL_2", "weight": 50, "name": null, "next_id": 0}, {"id": 3, "group_id": 1, "comment": "立て込んでるから依頼なら簡潔に頼むぜ。", "voice": "2112_VOICE_BULIVISIT_NORMAL_3", "weight": 50, "name": null, "next_id": 0}, {"id": 4, "group_id": 1, "comment": "いい加減俺も結婚を考えないとやばいか…ってなんだお前？いつからいたんだよ！", "voice": "2112_VOICE_BULIVISIT_RARE_1", "weight": 10, "name": null, "next_id": 0}, {"id": 5, "group_id": 1, "comment": "たまにはゆっくりしてったらどうだ？お前さんの冒険譚、俺にも聞かせてくれよ。", "voice": "2112_VOICE_BULIVISIT_RARE_2", "weight": 10, "name": null, "next_id": 0}, {"id": 6, "group_id": 2, "comment": "新しい装備品が作れるな。", "voice": "2112_VOICE_BULIVISIT_NEW_1", "weight": 50, "name": null, "next_id": 0}, {"id": 7, "group_id": 2, "comment": "お前さんに勧めたいモンがあるんだが見てくかい？", "voice": "2112_VOICE_BULIVISIT_NEW_2", "weight": 50, "name": null, "next_id": 0}, {"id": 8, "group_id": 3, "comment": "何が欲しいんだ？", "voice": "2112_VOICE_BUIL_TOP_1", "weight": 50, "name": null, "next_id": 0}, {"id": 10, "group_id": 4, "comment": "俺が鍛えてやる。", "voice": "2112_VOICE_BUIL_TOP_2", "weight": 50, "name": null, "next_id": 0}, {"id": 12, "group_id": 5, "comment": "やるからには気合入れろよ？", "voice": "2112_VOICE_BUIL_TOP_3", "weight": 100, "name": null, "next_id": 0}, {"id": 13, "group_id": 6, "comment": "装備品の把握くらいしておけよ。", "voice": "2112_VOICE_BUIL_TOP_4", "weight": 100, "name": null, "next_id": 0}, {"id": 14, "group_id": 7, "comment": "素材の重要さを舐めちゃいけねえぜ。", "voice": "2112_VOICE_BUIL_TOP_5", "weight": 100, "name": null, "next_id": 0}, {"id": 15, "group_id": 8, "comment": "黙って見てな。", "voice": "2112_VOICE_BUIL_FUNCTION_1_01", "weight": 100, "name": null, "next_id": 0}, {"id": 16, "group_id": 11, "comment": "ざっとこんなもんだ。", "voice": "2112_VOICE_BUIL_FUNCTION_1_02", "weight": 100, "name": null, "next_id": 0}, {"id": 17, "group_id": 9, "comment": "あぶねえから下がってな。", "voice": "2112_VOICE_BUIL_FUNCTION_2_01", "weight": 100, "name": null, "next_id": 0}, {"id": 18, "group_id": 12, "comment": "自信作だぜ。", "voice": "2112_VOICE_BUIL_FUNCTION_2_02", "weight": 100, "name": null, "next_id": 0}, {"id": 19, "group_id": 10, "comment": "悪いがちょっと静かにしてくれ。", "voice": "2112_VOICE_BUIL_FUNCTION_3_01", "weight": 100, "name": null, "next_id": 0}, {"id": 20, "group_id": 13, "comment": "文句なしの出来栄えだ！", "voice": "2112_VOICE_BUIL_FUNCTION_3_02", "weight": 100, "name": null, "next_id": 0}, {"id": 21, "group_id": 14, "comment": "任せな！", "voice": "2112_VOICE_BUIL_FUNCTION_4_01", "weight": 100, "name": null, "next_id": 0}, {"id": 22, "group_id": 17, "comment": "そら、できたぜ！", "voice": "2112_VOICE_BUIL_FUNCTION_4_02", "weight": 100, "name": null, "next_id": 0}, {"id": 23, "group_id": 20, "comment": "いい味が出てきたじゃねえか。", "voice": "2112_VOICE_BUIL_FUNCTION_4_03", "weight": 100, "name": null, "next_id": 0}, {"id": 24, "group_id": 15, "comment": "鍛え甲斐がありそうだな。", "voice": "2112_VOICE_BUIL_FUNCTION_5_01", "weight": 100, "name": null, "next_id": 0}, {"id": 25, "group_id": 18, "comment": "いいもん使ってるじゃねえか。", "voice": "2112_VOICE_BUIL_FUNCTION_5_02", "weight": 100, "name": null, "next_id": 0}, {"id": 26, "group_id": 21, "comment": "魂を感じるぜ？", "voice": "2112_VOICE_BUIL_FUNCTION_5_03", "weight": 100, "name": null, "next_id": 0}, {"id": 27, "group_id": 16, "comment": "魂を込めるぜ…！", "voice": "2112_VOICE_BUIL_FUNCTION_6_01", "weight": 100, "name": null, "next_id": 0}, {"id": 28, "group_id": 19, "comment": "見てみな。輝きを増してるぜ。", "voice": "2112_VOICE_BUIL_FUNCTION_6_02", "weight": 100, "name": null, "next_id": 0}, {"id": 29, "group_id": 22, "comment": "こいつに関しちゃ、もう言う事はねえよ。", "voice": "2112_VOICE_BUIL_FUNCTION_6_03", "weight": 100, "name": null, "next_id": 0}, {"id": 30, "group_id": 23, "comment": "俺を信じて見ていろ！", "voice": "2112_VOICE_BUIL_FUNCTION_7", "weight": 100, "name": null, "next_id": 0}, {"id": 31, "group_id": 24, "comment": "武具の可能性ってのはすげえだろ？", "voice": "2112_VOICE_BUIL_FUNCTION_8", "weight": 100, "name": null, "next_id": 0}, {"id": 32, "group_id": 25, "comment": "武具は大切に扱えよ！", "voice": "2112_VOICE_BUILLEAVE_01", "weight": 50, "name": null, "next_id": 0}, {"id": 33, "group_id": 25, "comment": "手入れを怠るなよ！", "voice": "2112_VOICE_BUILLEAVE_02", "weight": 50, "name": null, "next_id": 0}, {"id": 34, "group_id": 25, "comment": "またいい仕事待ってるぜ。", "voice": "2112_VOICE_BUILLEAVE_03", "weight": 50, "name": null, "next_id": 0}, {"id": 35, "group_id": 26, "comment": "ぅお！まだいたのかよ？", "voice": "2112_VOICE_BUILLLEAVEALONE", "weight": 100, "name": null, "next_id": 0}, {"id": 36, "group_id": 27, "comment": "ようこそいらっしゃいました。", "voice": "2113_VOICE_BULIVISIT_NORMAL_1", "weight": 50, "name": null, "next_id": 0}, {"id": 37, "group_id": 27, "comment": "敬虔なるあなたを\r\n歓迎致します。", "voice": "2113_VOICE_BULIVISIT_NORMAL_2", "weight": 50, "name": null, "next_id": 0}, {"id": 38, "group_id": 27, "comment": "今日のご用件をお聞かせください。", "voice": "2113_VOICE_BULIVISIT_NORMAL_3", "weight": 50, "name": null, "next_id": 0}, {"id": 39, "group_id": 27, "comment": "あ！来てくれ…コホン、お待ちしていました。", "voice": "2113_VOICE_BULIVISIT_RARE_1", "weight": 10, "name": null, "next_id": 0}, {"id": 40, "group_id": 27, "comment": "今日も色々お話を聞かせてください。", "voice": "2113_VOICE_BULIVISIT_RARE_2", "weight": 10, "name": null, "next_id": 0}, {"id": 42, "group_id": 28, "comment": "あなたの記録が増えています♪", "voice": "2113_VOICE_BULIVISIT_NEW_1", "weight": 50, "name": null, "next_id": 0}, {"id": 43, "group_id": 28, "comment": "日々努力なさってるんですね。", "voice": "2113_VOICE_BULIVISIT_NEW_2", "weight": 50, "name": null, "next_id": 0}, {"id": 44, "group_id": 29, "comment": "図鑑ですね♪", "voice": "2113_VOICE_BUIL_TOP_1", "weight": 50, "name": null, "next_id": 0}, {"id": 46, "group_id": 30, "comment": "戦績ですね。", "voice": "2113_VOICE_BUIL_TOP_2", "weight": 50, "name": null, "next_id": 0}, {"id": 48, "group_id": 31, "comment": "歴史ですね♪", "voice": "2113_VOICE_BUIL_TOP_3", "weight": 50, "name": null, "next_id": 0}, {"id": 50, "group_id": 32, "comment": "英雄たちの記録です。", "voice": "2113_VOICE_BUIL_FUNCTION_1", "weight": 100, "name": null, "next_id": 0}, {"id": 51, "group_id": 33, "comment": "モンスターの情報です。", "voice": "2113_VOICE_BUIL_FUNCTION_2", "weight": 100, "name": null, "next_id": 0}, {"id": 52, "group_id": 34, "comment": "素晴らしいアイテムの数々です。", "voice": "2113_VOICE_BUIL_FUNCTION_3", "weight": 50, "name": null, "next_id": 0}, {"id": 54, "group_id": 35, "comment": "どんなものがあるんでしょう？", "voice": "2113_VOICE_BUIL_FUNCTION_4", "weight": 100, "name": null, "next_id": 0}, {"id": 55, "group_id": 36, "comment": "凄い冒険でした！", "voice": "2113_VOICE_BUIL_FUNCTION_5", "weight": 50, "name": null, "next_id": 0}, {"id": 57, "group_id": 37, "comment": "あなたに神のご加護がありますように…", "voice": "2113_VOICE_BUILLEAVE_01", "weight": 50, "name": null, "next_id": 0}, {"id": 58, "group_id": 37, "comment": "またいらしてください♪", "voice": "2113_VOICE_BUILLEAVE_02", "weight": 50, "name": null, "next_id": 0}, {"id": 59, "group_id": 37, "comment": "あなたのこと応援させてください♪", "voice": "2113_VOICE_BUILLEAVE_03", "weight": 50, "name": null, "next_id": 0}, {"id": 60, "group_id": 38, "comment": "な、なんで黙ってるんですか！", "voice": "2113_VOICE_BUILLLEAVEALONE", "weight": 100, "name": null, "next_id": 0}, {"id": 61, "group_id": 39, "comment": "いらっしゃい。", "voice": "2115_VOICE_BULIVISIT_NORMAL_1", "weight": 50, "name": null, "next_id": 0}, {"id": 62, "group_id": 39, "comment": "あぁ、来たの。", "voice": "2115_VOICE_BULIVISIT_NORMAL_2", "weight": 50, "name": null, "next_id": 0}, {"id": 63, "group_id": 39, "comment": "勝手にやっててよね。", "voice": "2115_VOICE_BULIVISIT_NORMAL_3", "weight": 50, "name": null, "next_id": 0}, {"id": 64, "group_id": 39, "comment": "最近腕を上げたみたいね。", "voice": "2115_VOICE_BULIVISIT_RARE_1", "weight": 10, "name": null, "next_id": 0}, {"id": 65, "group_id": 39, "comment": "あ…今日は何作る気？", "voice": "2115_VOICE_BULIVISIT_RARE_2", "weight": 10, "name": null, "next_id": 0}, {"id": 66, "group_id": 40, "comment": "あ、新しいレシピ増えてる。", "voice": "2115_VOICE_BULIVISIT_NEW_1", "weight": 50, "name": null, "next_id": 0}, {"id": 67, "group_id": 40, "comment": "新しい料理に挑戦するの？", "voice": "2115_VOICE_BULIVISIT_NEW_2", "weight": 50, "name": null, "next_id": 0}, {"id": 68, "group_id": 41, "comment": "お手並み拝見と行こうかしら。", "voice": "2115_VOICE_BUIL_TOP_1", "weight": 50, "name": null, "next_id": 0}, {"id": 69, "group_id": 41, "comment": "作ったものはちゃんと食べなさい。", "voice": "2115_VOICE_BUIL_TOP_2", "weight": 50, "name": null, "next_id": 0}, {"id": 70, "group_id": 42, "comment": "ちゃんと確認しておきなさい。", "voice": "2115_VOICE_BUIL_TOP_3", "weight": 50, "name": null, "next_id": 0}, {"id": 71, "group_id": 42, "comment": "レシピを増やさないと上達なんてしないんだからね。", "voice": "2115_VOICE_BUIL_TOP_4", "weight": 50, "name": null, "next_id": 0}, {"id": 72, "group_id": 43, "comment": "見ててあげるわ。", "voice": "2115_VOICE_BUIL_FUNCTION_1", "weight": 50, "name": null, "next_id": 0}, {"id": 74, "group_id": 44, "comment": "そのくらいで喜んでるんじゃないわよ。", "voice": "2115_VOICE_BUIL_FUNCTION_2_01", "weight": 50, "name": null, "next_id": 0}, {"id": 75, "group_id": 44, "comment": "こんなの当然よ。", "voice": "2115_VOICE_BUIL_FUNCTION_2_02", "weight": 50, "name": null, "next_id": 0}, {"id": 76, "group_id": 45, "comment": "あれ、思ったより上達してるし…", "voice": "2115_VOICE_BUIL_FUNCTION_3_01", "weight": 50, "name": null, "next_id": 0}, {"id": 77, "group_id": 45, "comment": "まぐれ…じゃなさそうね。", "voice": "2115_VOICE_BUIL_FUNCTION_3_02", "weight": 50, "name": null, "next_id": 0}, {"id": 78, "group_id": 46, "comment": "うん。よくできてる…！", "voice": "2115_VOICE_BUIL_FUNCTION_4_01", "weight": 50, "name": null, "next_id": 0}, {"id": 79, "group_id": 46, "comment": "な…なんかお腹空いてきたじゃない！", "voice": "2115_VOICE_BUIL_FUNCTION_4_02", "weight": 50, "name": null, "next_id": 0}, {"id": 80, "group_id": 47, "comment": "全然ダメね！", "voice": "2115_VOICE_BUIL_FUNCTION_5", "weight": 100, "name": null, "next_id": 0}, {"id": 81, "group_id": 48, "comment": "もう！私が教えてあげるわよ！", "voice": "2115_VOICE_BUIL_FUNCTION_6", "weight": 100, "name": null, "next_id": 0}, {"id": 82, "group_id": 49, "comment": "ま、結構頑張ったと思うけどね。", "voice": "2115_VOICE_BUIL_FUNCTION_7", "weight": 100, "name": null, "next_id": 0}, {"id": 83, "group_id": 50, "comment": "ちゃんと練習もしておきなさいよ？", "voice": "2115_VOICE_BUILLEAVE_01", "weight": 50, "name": null, "next_id": 0}, {"id": 84, "group_id": 50, "comment": "腕を上げてまた来なさい！", "voice": "2115_VOICE_BUILLEAVE_02", "weight": 50, "name": null, "next_id": 0}, {"id": 85, "group_id": 50, "comment": "帰るんだ…じゃ、じゃあね！", "voice": "2115_VOICE_BUILLEAVE_03", "weight": 50, "name": null, "next_id": 0}, {"id": 86, "group_id": 51, "comment": "あんた…暇なの？", "voice": "2115_VOICE_BUILLLEAVEALONE", "weight": 100, "name": null, "next_id": 0}, {"id": 87, "group_id": 52, "comment": "戦士たちの聖域へようこそ。", "voice": "2114_VOICE_BULIVISIT_NORMAL_1", "weight": 50, "name": null, "next_id": 0}, {"id": 88, "group_id": 52, "comment": "あなたでしたか…！", "voice": "2114_VOICE_BULIVISIT_NORMAL_2", "weight": 50, "name": null, "next_id": 0}, {"id": 89, "group_id": 52, "comment": "さあ、観衆が待っています！", "voice": "2114_VOICE_BULIVISIT_NORMAL_3", "weight": 50, "name": null, "next_id": 0}, {"id": 90, "group_id": 52, "comment": "お待ちしていました！さあ、あなたの戦いを見せてください！", "voice": "2114_VOICE_BULIVISIT_RARE_1", "weight": 10, "name": null, "next_id": 0}, {"id": 91, "group_id": 52, "comment": "フフ、分かってましたよ。あなたがまたここを訪れることは。", "voice": "2114_VOICE_BULIVISIT_RARE_2", "weight": 10, "name": null, "next_id": 0}, {"id": 92, "group_id": 53, "comment": "戦いの日々に終わりはありません。", "voice": "2114_VOICE_BULIVISIT_NEW_1", "weight": 50, "name": null, "next_id": 0}, {"id": 93, "group_id": 53, "comment": "もっと上を目指すのですよね？", "voice": "2114_VOICE_BULIVISIT_NEW_2", "weight": 50, "name": null, "next_id": 0}, {"id": 94, "group_id": 54, "comment": "あなたの現在の成績です。", "voice": "2114_VOICE_BUIL_TOP_1", "weight": 100, "name": null, "next_id": 0}, {"id": 95, "group_id": 55, "comment": "報酬はこちらになります。", "voice": "2114_VOICE_BUIL_TOP_2", "weight": 100, "name": null, "next_id": 0}, {"id": 96, "group_id": 56, "comment": "さあ、胸躍る戦いを！", "voice": "2114_VOICE_BUIL_TOP_3", "weight": 100, "name": null, "next_id": 0}, {"id": 97, "group_id": 57, "comment": "おめでとうございます。", "voice": "2114_VOICE_BUIL_FUNCTION_1", "weight": 50, "name": null, "next_id": 0}, {"id": 99, "group_id": 58, "comment": "次は期待しています。", "voice": "2114_VOICE_BUIL_FUNCTION_2", "weight": 50, "name": null, "next_id": 0}, {"id": 101, "group_id": 59, "comment": "おめでとうございます♪", "voice": "2114_VOICE_BUIL_FUNCTION_3", "weight": 50, "name": null, "next_id": 0}, {"id": 102, "group_id": 59, "comment": "もっと上を目指すのですね。", "voice": "2114_VOICE_BUIL_FUNCTION_4", "weight": 50, "name": null, "next_id": 0}, {"id": 103, "group_id": 63, "comment": "残念です。", "voice": "2114_VOICE_BUIL_FUNCTION_5", "weight": 50, "name": null, "next_id": 0}, {"id": 104, "group_id": 63, "comment": "油断大敵です。", "voice": "2114_VOICE_BUIL_FUNCTION_6", "weight": 50, "name": null, "next_id": 0}, {"id": 105, "group_id": 60, "comment": "お疲れ様です。今回はここまでとなります。", "voice": "2114_VOICE_BUIL_FUNCTION_7", "weight": 50, "name": null, "next_id": 0}, {"id": 106, "group_id": 60, "comment": "戦士にも休息は必要です。今はゆっくり休んでください。", "voice": "2114_VOICE_BUIL_FUNCTION_8", "weight": 50, "name": null, "next_id": 0}, {"id": 107, "group_id": 61, "comment": "またいらしてください。", "voice": "2114_VOICE_BUILLEAVE_01", "weight": 50, "name": null, "next_id": 0}, {"id": 108, "group_id": 61, "comment": "次も期待しています。", "voice": "2114_VOICE_BUILLEAVE_02", "weight": 50, "name": null, "next_id": 0}, {"id": 109, "group_id": 61, "comment": "またいらっしゃるのを楽しみにしています。", "voice": "2114_VOICE_BUILLEAVE_03", "weight": 50, "name": null, "next_id": 0}, {"id": 110, "group_id": 62, "comment": "今日はずいぶんと静かですね。", "voice": "2114_VOICE_BUILLLEAVEALONE", "weight": 100, "name": null, "next_id": 0}, {"id": 111, "group_id": 64, "comment": "よく来たな。", "voice": "2111_VOICE_BULIVISIT_NORMAL_1", "weight": 50, "name": null, "next_id": 0}, {"id": 112, "group_id": 64, "comment": "おう。いい仕事入ってるぜ。", "voice": "2111_VOICE_BULIVISIT_NORMAL_2", "weight": 50, "name": null, "next_id": 0}, {"id": 113, "group_id": 64, "comment": "今日は何の用だ？", "voice": "2111_VOICE_BULIVISIT_NORMAL_3", "weight": 50, "name": null, "next_id": 0}, {"id": 114, "group_id": 64, "comment": "まったくアイツは…うぉっ、驚かせるな！", "voice": "2111_VOICE_BULIVISIT_RARE_1", "weight": 10, "name": null, "next_id": 0}, {"id": 116, "group_id": 65, "comment": "おっ、丁度いい時に来たな！", "voice": "2111_VOICE_BULIVISIT_NEW_1", "weight": 50, "name": null, "next_id": 0}, {"id": 117, "group_id": 65, "comment": "ちっとばかり手強い依頼があるがどうする？", "voice": "2111_VOICE_BULIVISIT_NEW_2", "weight": 50, "name": null, "next_id": 0}, {"id": 118, "group_id": 66, "comment": "これが今ある依頼だ。", "voice": "2111_VOICE_BUIL_TOP_1", "weight": 50, "name": null, "next_id": 0}, {"id": 120, "group_id": 67, "comment": "こんなとこだな", "voice": "2111_VOICE_BUIL_TOP_2", "weight": 50, "name": null, "next_id": 0}, {"id": 122, "group_id": 68, "comment": "手応えあるぜ？", "voice": "2111_VOICE_BUIL_TOP_3", "weight": 50, "name": null, "next_id": 0}, {"id": 124, "group_id": 69, "comment": "とっとと終わらせてこい。", "voice": "2111_VOICE_BUIL_FUNCTION_1", "weight": 100, "name": null, "next_id": 0}, {"id": 125, "group_id": 70, "comment": "油断するんじゃねーぞ。", "voice": "2111_VOICE_BUIL_FUNCTION_2", "weight": 100, "name": null, "next_id": 0}, {"id": 126, "group_id": 71, "comment": "無茶はするなよ。", "voice": "2111_VOICE_BUIL_FUNCTION_3", "weight": 100, "name": null, "next_id": 0}, {"id": 127, "group_id": 72, "comment": "ガッハッハ、このくらいなら楽勝か？", "voice": "2111_VOICE_BUIL_FUNCTION_4", "weight": 100, "name": null, "next_id": 0}, {"id": 128, "group_id": 73, "comment": "やるじゃねえか。お前にならもっと任せられそうだ。", "voice": "2111_VOICE_BUIL_FUNCTION_5", "weight": 100, "name": null, "next_id": 0}, {"id": 129, "group_id": 74, "comment": "文句無しだ。次の任務もよろしく頼むぜ。", "voice": "2111_VOICE_BUIL_FUNCTION_6", "weight": 100, "name": null, "next_id": 0}, {"id": 130, "group_id": 75, "comment": "フン、まあいい。", "voice": "2111_VOICE_BUIL_FUNCTION_7", "weight": 50, "name": null, "next_id": 0}, {"id": 131, "group_id": 75, "comment": "ったくしょうがねえな。", "voice": "2111_VOICE_BUIL_FUNCTION_8", "weight": 50, "name": null, "next_id": 0}, {"id": 132, "group_id": 76, "comment": "また来いよ。", "voice": "2111_VOICE_BUILLEAVE_01", "weight": 50, "name": null, "next_id": 0}, {"id": 133, "group_id": 76, "comment": "訓練も怠るなよ。", "voice": "2111_VOICE_BUILLEAVE_02", "weight": 50, "name": null, "next_id": 0}, {"id": 134, "group_id": 76, "comment": "お疲れさん。", "voice": "2111_VOICE_BUILLEAVE_03", "weight": 50, "name": null, "next_id": 0}, {"id": 135, "group_id": 77, "comment": "さて、後は任せて飲みにでも…うぉっ、じょ、冗談だ、冗談！で、何の用だ！", "voice": "2111_VOICE_BUILLLEAVEALONE", "weight": 100, "name": null, "next_id": 0}, {"id": 136, "group_id": 78, "comment": "いらっしゃい…", "voice": "2116_VOICE_BULIVISIT_NORMAL_1", "weight": 50, "name": null, "next_id": 0}, {"id": 137, "group_id": 78, "comment": "どうしてほしいの？", "voice": "2116_VOICE_BULIVISIT_NORMAL_2", "weight": 50, "name": null, "next_id": 0}, {"id": 138, "group_id": 78, "comment": "何を望んでいるの？", "voice": "2116_VOICE_BULIVISIT_NORMAL_4", "weight": 50, "name": null, "next_id": 0}, {"id": 139, "group_id": 78, "comment": "また来てしまったのね…", "voice": "2116_VOICE_BULIVISIT_NORMAL_3", "weight": 50, "name": null, "next_id": 0}, {"id": 140, "group_id": 78, "comment": "いいのよ…ゆっくりしていっても。", "voice": "2116_VOICE_BULIVISIT_RARE_1", "weight": 10, "name": null, "next_id": 0}, {"id": 141, "group_id": 78, "comment": "あら…ちょうどお茶を淹れたところなの。一緒にいかが？", "voice": "2116_VOICE_BULIVISIT_RARE_2", "weight": 10, "name": null, "next_id": 0}, {"id": 142, "group_id": 79, "comment": "キミだったのね…", "voice": "2116_VOICE_BULIVISIT_NEW_1", "weight": 50, "name": null, "next_id": 0}, {"id": 143, "group_id": 79, "comment": "私に会いに来たの？", "voice": "2116_VOICE_BULIVISIT_NEW_2", "weight": 50, "name": null, "next_id": 0}, {"id": 144, "group_id": 80, "comment": "驚かないようにね？", "voice": "2116_VOICE_BUIL_TOP_1", "weight": 50, "name": null, "next_id": 0}, {"id": 146, "group_id": 81, "comment": "止めはしないけど…", "voice": "2116_VOICE_BUIL_TOP_2", "weight": 50, "name": null, "next_id": 0}, {"id": 148, "group_id": 82, "comment": "責任を持って引き取るわ。", "voice": "2116_VOICE_BUIL_TOP_3", "weight": 50, "name": null, "next_id": 0}, {"id": 150, "group_id": 83, "comment": "どれを売りたいの？", "voice": "2116_VOICE_BUIL_TOP_4", "weight": 50, "name": null, "next_id": 0}, {"id": 152, "group_id": 84, "comment": "いい趣味をしているわ…", "voice": "2116_VOICE_BUIL_FUNCTION_1", "weight": 50, "name": null, "next_id": 0}, {"id": 154, "group_id": 85, "comment": "じゃあ始めるわよ。", "voice": "2116_VOICE_BUIL_FUNCTION_2_01", "weight": 50, "name": null, "next_id": 0}, {"id": 155, "group_id": 85, "comment": "呑まれないようにね。", "voice": "2116_VOICE_BUIL_FUNCTION_2_02", "weight": 50, "name": null, "next_id": 0}, {"id": 156, "group_id": 86, "comment": "新たなる魂ね…", "voice": "2116_VOICE_BUIL_FUNCTION_3", "weight": 50, "name": null, "next_id": 0}, {"id": 158, "group_id": 87, "comment": "ただの道具ではないわよ？", "voice": "2116_VOICE_BUIL_FUNCTION_4", "weight": 50, "name": null, "next_id": 0}, {"id": 160, "group_id": 88, "comment": "珍しいわ。", "voice": "2116_VOICE_BUIL_FUNCTION_5", "weight": 50, "name": null, "next_id": 0}, {"id": 162, "group_id": 92, "comment": "力が反発しちゃったかしら。", "voice": "2116_VOICE_BUIL_FUNCTION_6", "weight": 50, "name": null, "next_id": 0}, {"id": 164, "group_id": 89, "comment": "フフ…ありがとう。", "voice": "2116_VOICE_BUIL_FUNCTION_7", "weight": 50, "name": null, "next_id": 0}, {"id": 167, "group_id": 90, "comment": "いつでもいらっしゃい。", "voice": "2116_VOICE_BUILLEAVE_01", "weight": 50, "name": null, "next_id": 0}, {"id": 168, "group_id": 90, "comment": "また会いましょう？", "voice": "2116_VOICE_BUILLEAVE_02", "weight": 50, "name": null, "next_id": 0}, {"id": 169, "group_id": 90, "comment": "私に会いに来るだけでもいいのよ……", "voice": "2116_VOICE_BUILLEAVE_03", "weight": 50, "name": null, "next_id": 0}, {"id": 170, "group_id": 91, "comment": "今日はのんびりしているのね。私と２人っきりだからかしら？", "voice": "2116_VOICE_BUILLLEAVEALONE", "weight": 100, "name": null, "next_id": 0}, {"id": 171, "group_id": 93, "comment": "こんにちは。資料室なら開いてるわよ。", "voice": "2117_VOICE_BULIVISIT_CLOSE_1", "weight": 100, "name": "セラ", "next_id": 0}, {"id": 172, "group_id": 93, "comment": "いらっしゃい。室長なら出かけてるわよ。", "voice": "2117_VOICE_BULIVISIT_CLOSE_2", "weight": 100, "name": "セラ", "next_id": 0}, {"id": 173, "group_id": 93, "comment": "あら？　何か用かしら？", "voice": "2117_VOICE_BULIVISIT_CLOSE_3", "weight": 100, "name": "セラ", "next_id": 0}, {"id": 174, "group_id": 93, "comment": "鉱山の魔獣の情報は資料室にまとめてあるわよ。", "voice": "2117_VOICE_BULIVISIT_CLOSE_4", "weight": 100, "name": "セラ", "next_id": 0}, {"id": 175, "group_id": 93, "comment": "私に会いに来たの？", "voice": "2117_VOICE_BULIVISIT_CLOSE_5", "weight": 100, "name": "セラ", "next_id": 0}, {"id": 176, "group_id": 94, "comment": "坑道は入り組んでいて、道に迷いやすいから注意してくれ。", "voice": "2117_VOICE_BULIVISIT_OPEN_ARCANA_2", "weight": 100, "name": "アルカナ", "next_id": 177}, {"id": 177, "group_id": 94, "comment": "室長もよく迷子になってますよね。", "voice": "2117_VOICE_BULIVISIT_OPEN_SERA_2", "weight": 0, "name": "セラ", "next_id": 0}, {"id": 178, "group_id": 94, "comment": "採掘には危険がつきものだ。いついかなる時も注意を怠らないよう気をつけてくれ。", "voice": "2117_VOICE_BULIVISIT_OPEN_ARCANA_3", "weight": 100, "name": "アルカナ", "next_id": 179}, {"id": 179, "group_id": 94, "comment": "さっき何もないところで転んでたくせに～。", "voice": "2117_VOICE_BULIVISIT_OPEN_SERA_3", "weight": 0, "name": "セラ", "next_id": 0}, {"id": 180, "group_id": 95, "comment": "帰るんだ。またね！", "voice": "2117_VOICE_BUILLEAVE_1", "weight": 100, "name": "セラ", "next_id": 0}, {"id": 181, "group_id": 95, "comment": "お疲れ様ー！", "voice": "2117_VOICE_BUILLEAVE_2", "weight": 100, "name": "セラ", "next_id": 0}, {"id": 182, "group_id": 96, "comment": "帰るんだ。またね！", "voice": "2117_VOICE_BUILLEAVE_1", "weight": 100, "name": "セラ", "next_id": 0}, {"id": 183, "group_id": 96, "comment": "お疲れ様ー！", "voice": "2117_VOICE_BUILLEAVE_2", "weight": 100, "name": "セラ", "next_id": 0}, {"id": 184, "group_id": 96, "comment": "お疲れ様。", "voice": "2117_VOICE_BUILLEAVE_3", "weight": 100, "name": "アルカナ", "next_id": 0}, {"id": 185, "group_id": 97, "comment": "ちょうど暇していたところだ。まぁそこに座れ。", "voice": "2392_VOICE_FREE_A", "weight": 100, "name": null, "next_id": 0}, {"id": 186, "group_id": 97, "comment": "今日はなにをつくるつもりだ？", "voice": "2392_VOICE_FREE_B", "weight": 100, "name": null, "next_id": 0}, {"id": 187, "group_id": 97, "comment": "おおよく来た。菓子でも食っていけ、お代はいただくがな", "voice": "2392_VOICE_FREE_C", "weight": 100, "name": null, "next_id": 0}, {"id": 188, "group_id": 97, "comment": "一度やると病みつきになるだろう？　その気持ちはわかるぞ", "voice": "2392_VOICE_FREE_D", "weight": 100, "name": null, "next_id": 0}, {"id": 190, "group_id": 98, "comment": "手ぶらで来たのか？　まったく常識を知らんなあ。", "voice": "2392_VOICE_FREE_E", "weight": 100, "name": null, "next_id": 0}, {"id": 191, "group_id": 99, "comment": "今日はなにをつくるつもりだ？", "voice": "2392_VOICE_FREE_B", "weight": 100, "name": null, "next_id": 0}, {"id": 192, "group_id": 100, "comment": "悪いな、ウチの店は海賊専門だ。グランドバトルで立派な海賊になったら相手してやるよ。", "voice": null, "weight": 100, "name": null, "next_id": 0}, {"id": 193, "group_id": 101, "comment": "クラフト装備大全だ\r\n特別に見せてやろう", "voice": null, "weight": 100, "name": null, "next_id": 0}]