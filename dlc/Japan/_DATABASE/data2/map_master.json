[{"id": 10000, "name": "イスリーダ帝国", "map_no": 10000, "icon_position_x": 412, "icon_position_y": 1190, "is_special": 0, "view_type": 0, "event_title": "イスリーダ邂逅編", "event_description": "一流の冒険者を志すレイアスは\r\n冒険者ギルドの入会試験の最中\r\n記憶を無くした少女イリスに出会う。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 20000, "name": "グラメニア共和国", "map_no": 20000, "icon_position_x": 890, "icon_position_y": 762, "is_special": 0, "view_type": 0, "event_title": "グラメニア陰謀編", "event_description": "封魔の塔にてグラードを退けたレイアスたちは\r\nロイに導かれグラメニア共和国へと渡る。\r\nこの地にいるという新たな仲間を求めて。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 30000, "name": "ファメル王国西部", "map_no": 30000, "icon_position_x": 832, "icon_position_y": 330, "is_special": 0, "view_type": 0, "event_title": "ファメル探索編", "event_description": "塔は魔族の封印を解く為の鍵だった。\r\nレイアスたちは、さらなる手がかりを求め\r\nフェンと共に王立図書館『ラガン』に向かう。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 40000, "name": "ファメル王国東部", "map_no": 40000, "icon_position_x": 1360, "icon_position_y": 368, "is_special": 0, "view_type": 0, "event_title": "ファメルの英雄編", "event_description": "イリスに似た少女の出現に戸惑うレイアス。\r\nだが今は立ち止まれない。一行は魔族の完全復活を\r\n阻止する為、封魔の塔『リーマー』へと急ぐ。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 50000, "name": "封魔域ゴルモレイ", "map_no": 50000, "icon_position_x": 1620, "icon_position_y": 656, "is_special": 0, "view_type": 0, "event_title": "ゴルモレイ決戦編", "event_description": "皆を護る――何があろうともその決意は変わらない。\r\nレイアスは魔族との闘いに終止符を打つべく\r\nラグシェルムの待つ魔城ゴルモレイへと乗り込む。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 60000, "name": "バーミント公国", "map_no": 60000, "icon_position_x": 1200, "icon_position_y": 1500, "is_special": 0, "view_type": 1, "event_title": "バーミント失踪編", "event_description": "ミラ投獄の噂を聞いたレイアスとイリスは\r\n真相を確かめる為、一路バーミント公国を目指す。\r\n無事でいて欲しい――たったひとつの願いを胸に。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 70000, "name": "ラ＝リズ魔導教国", "map_no": 70000, "icon_position_x": 1700, "icon_position_y": 1020, "is_special": 0, "view_type": 1, "event_title": "ラ＝リズ襲撃編", "event_description": "気がかりな言葉を残して姿を消したミラ。\r\nレイアスたちは彼女の真意を確かめるべく\r\nメリアと共にラ＝リズ魔導教国へと旅立つ。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 80000, "name": "ラ＝リズ空中都市", "map_no": 80000, "icon_position_x": 1600, "icon_position_y": 1600, "is_special": 0, "view_type": 1, "event_title": "ラ＝リズ宿命編", "event_description": "もう大切な人を失いたくない――薄れる意識の中\r\nメリアはそう呟いた。レイアスは彼女の想いを背負い\r\n教団の刺客が待つ空中都市へと向かう。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 90000, "name": "イスリーダ地下大空洞", "map_no": 90000, "icon_position_x": 700, "icon_position_y": 1250, "is_special": 0, "view_type": 1, "event_title": "イスリーダ陰謀編", "event_description": "覇罪皇ギアベールと天魔帥ゼ＝レムナ。\r\n復活した二柱の魔神から人々を護る為\r\nレイアスたちはイスリーダへと急還する。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 100000, "name": "封神域", "map_no": 100000, "icon_position_x": 412, "icon_position_y": 860, "is_special": 0, "view_type": 1, "event_title": "封神域の公女編", "event_description": "「シーリアは敵だ――」突然、世界は色を変えた。\r\n古代種のこと。記憶のこと。仲間のこと。シーリアのこと。\r\n万感の思いを胸に、いざ決戦の地、封神域へ。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 110000, "name": "ファメル王国北部", "map_no": 110000, "icon_position_x": 1110, "icon_position_y": 520, "is_special": 0, "view_type": 1, "event_title": "ファメル脱出編", "event_description": "封魔の塔を持つ国に対し、教団が突如侵攻を開始した。\r\nだが教団の目的は、塔だけではなかった――\r\n戦雲渦巻くラクトヘルムで、今、新たな冒険が始まる。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 120000, "name": "グラメニア中部", "map_no": 120000, "icon_position_x": 880, "icon_position_y": 978, "is_special": 0, "view_type": 1, "event_title": "グラメニア逃亡編", "event_description": "イリスは絶対に守り抜く――\r\nイスリーダへの帰還を目指すレイアスたちは、\r\n決意を胸に、教団はびこるグラメニア大陸を縦断する。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 130000, "name": "バーミント公国南部", "map_no": 130000, "icon_position_x": 1100, "icon_position_y": 1240, "is_special": 0, "view_type": 1, "event_title": "バーミント防衛編", "event_description": "敵は古代種――軍師フェンに導かれ\r\nレイアスたちは潜水艇でバーミント公国へと渡る。\r\n求めるは、かつてシーリアを討ちし王剣『グランスケル』", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 140000, "name": "ラ＝リズ魔導教国北部", "map_no": 140000, "icon_position_x": 1600, "icon_position_y": 1400, "is_special": 0, "view_type": 1, "event_title": "ラ=リズ激闘編", "event_description": "イリスを連れ去った古代種を追うレイアスたち。\r\n後悔はそれぞれの胸の内にしまい\r\n教団の本拠地、ラ＝リズ魔導教国を目指す。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 150000, "name": "ラ＝リズ魔導教国南部", "map_no": 150000, "icon_position_x": 1500, "icon_position_y": 1000, "is_special": 0, "view_type": 1, "event_title": "ラ＝リズ波乱編", "event_description": "何度拒絶されようとも諦めない――\r\nイリスを追うレイアスは不屈の闘志を胸に\r\nラ＝リズ魔導教国を縦断する。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 160000, "name": "イスリーダ北部", "map_no": 160000, "icon_position_x": 670, "icon_position_y": 1450, "is_special": 0, "view_type": 1, "event_title": "イスリーダ血戦編", "event_description": "お前は…俺の敵、なのか――\r\n願いと憎悪が交錯する空の下\r\nレイアスは希望の剣へと手を伸ばす。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 170000, "name": "イスリーダ西部", "map_no": 170000, "icon_position_x": 320, "icon_position_y": 1370, "is_special": 0, "view_type": 1, "event_title": "イスリーダ来訪編", "event_description": "束縛は三本の帝剣により解き放たれた。\r\n二つの世界は再び交わり\r\nラクトヘルムに新たな時代が訪れる。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 180000, "name": "グラメニア西部", "map_no": 180000, "icon_position_x": 700, "icon_position_y": 700, "is_special": 0, "view_type": 1, "event_title": "グラメニア邂逅編", "event_description": "交錯し始めた二つの世界。八つの種族。\r\n神族の国、クランベルジュの王子は、\r\n焔の記憶を胸に、王剣奪還を誓う。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 190000, "name": "グラメニア東部", "map_no": 190000, "icon_position_x": 1150, "icon_position_y": 890, "is_special": 0, "view_type": 1, "event_title": "グラメニア対立編", "event_description": "世界の雫は静かに胎動する。\r\n魔女の心は深淵へと沈み、\r\n拳士の想いはグラメニアを翔ける。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 200000, "name": "グラメニア南部", "map_no": 200000, "icon_position_x": 1100, "icon_position_y": 700, "is_special": 0, "view_type": 1, "event_title": "グラメニア追想編", "event_description": "不条理には抗わねばならない。\r\n永き旅の果てに辿り着いた地で\r\n孤高の軍師は再び扉を開く――", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 210000, "name": "ラ＝リズ魔導教国西部", "map_no": 210000, "icon_position_x": 1450, "icon_position_y": 1230, "is_special": 0, "view_type": 1, "event_title": "ラ＝リズ流星編", "event_description": "手放したのはどちらだったか。\r\n流星の落ちた地ラ＝リズの火口で\r\nふたりの願いは激突する――", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 220000, "name": "ラ＝リズ魔導教国東部", "map_no": 220000, "icon_position_x": 1730, "icon_position_y": 1200, "is_special": 0, "view_type": 1, "event_title": "ラ＝リズ新星編", "event_description": "流星は希望となって空を流れ\r\nラ＝リズの古城へと堕ち\r\nそして、新たな星が生まれる――", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 230000, "name": "バーミント公国 西部", "map_no": 230000, "icon_position_x": 950, "icon_position_y": 1430, "is_special": 0, "view_type": 1, "event_title": "バーミント飛翔編", "event_description": "変わらないものと変わりゆくもの。\r\n蔦の這う城壁の下で二人剣を交わす。\r\n過去と未来の狭間で彼女の心は燃えていた。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 240000, "name": "イスカトル 南部", "map_no": 240000, "icon_position_x": 1930, "icon_position_y": 890, "is_special": 0, "view_type": 1, "event_title": "イスカトル黎明編", "event_description": "東の果ての孤島イスカトル。\r\n希望と悔恨が辿りつく島で\r\n銃士は思いがけない人物と出会う――", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 250000, "name": "イスカトル 中部", "map_no": 250000, "icon_position_x": 2050, "icon_position_y": 1100, "is_special": 0, "view_type": 1, "event_title": "イスカトル胎動編", "event_description": "東の果ての新大陸イスカトル。\r\n数多の想いが辿り着く場所に\r\n願いなき超越者は舞い降りる。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 260000, "name": "イスカトル 東部", "map_no": 260000, "icon_position_x": 2150, "icon_position_y": 1270, "is_special": 0, "view_type": 1, "event_title": "イスカトル星霜編", "event_description": "すべての因子が同期し\r\n幾星霜を経て二つの影は重なった。\r\n今、イスカトルの丘に奇跡が顕現する。", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 270000, "name": "イスカトル 北部", "map_no": 270000, "icon_position_x": 2000, "icon_position_y": 1300, "is_special": 0, "view_type": 1, "event_title": "イスカトル蒼空編", "event_description": "皇帝の一振でイスカトルの空は変貌する。\r\n因果を断つルーンマスターが\r\n新たなる世界の扉を開こうとしていた――", "start_at": "None", "end_at": "None", "status": 1, "area_type": 1}, {"id": 280000, "name": "イスカトル 上空", "map_no": 280000, "icon_position_x": 2100, "icon_position_y": 1470, "is_special": 0, "view_type": 1, "event_title": "イスカトル盟約編", "event_description": "希望も絶望もここから始まった。\r\nイスカトルの空に浮かぶ世界樹。\r\n約束の地でレイアスはかつての友と対峙する。", "start_at": "2024-02-05 16:00:00+09:00", "end_at": "None", "status": 1, "area_type": 1}, {"id": 290000, "name": "ラ＝リズ魔導教国 北東部", "map_no": 290000, "icon_position_x": 1800, "icon_position_y": 1380, "is_special": 0, "view_type": 1, "event_title": "ラ=リズ月光編", "event_description": "それは、世界を壊す言葉――\r\nラクトヘルムの空に星々が降り注いだ日\r\n新たな命と新たな世界が目覚めた。", "start_at": "2024-05-31 14:00:00+09:00", "end_at": "None", "status": 1, "area_type": 1}, {"id": 300000, "name": "デウスゲート", "map_no": 300000, "icon_position_x": 480, "icon_position_y": 700, "is_special": 0, "view_type": 1, "event_title": "デウスゲート探訪編", "event_description": "転移ゲートを抜けて辿り着いたのは\r\n浮遊大陸世界アルトヘルム。\r\n残骸の世界でレイアスたちは新たな運命に出会う。", "start_at": "2024-08-21 14:00:00+09:00", "end_at": "None", "status": 1, "area_type": 2}, {"id": 310000, "name": "デウスゲート 中部", "map_no": 310000, "icon_position_x": 750, "icon_position_y": 765, "is_special": 0, "view_type": 1, "event_title": "デウスゲート響鳴編", "event_description": "浮遊大陸群、アルトヘルム。\r\n大空の世界でレイアスたちは\r\n神魔入り乱れる策謀の渦へと巻き込まれていく。", "start_at": "2024-11-08 16:00:00+09:00", "end_at": "None", "status": 1, "area_type": 2}, {"id": 320000, "name": "デウスゲート 中部②", "map_no": 320000, "icon_position_x": 840, "icon_position_y": 580, "is_special": 0, "view_type": 1, "event_title": "デウスゲート王剣編", "event_description": "グランスケルの切っ先が震える。\r\n神聖騎士団との闘いの最中、\r\nレイアスはもう一人の王剣使いと出会う。", "start_at": "2024-11-30 16:00:00+09:00", "end_at": "None", "status": 1, "area_type": 2}, {"id": 330000, "name": "ファルファニア北部", "map_no": 330000, "icon_position_x": 1260, "icon_position_y": 620, "is_special": 0, "view_type": 1, "event_title": "ファルファニア開宴編", "event_description": "紋章の剣士がアルトヘルムの空を見上げる。\r\n降り注ぐ閃光とともに、資格ある者たちの集い\r\n――大封印祭は開宴した。", "start_at": "2025-01-31 15:00:00+09:00", "end_at": "None", "status": 1, "area_type": 2}, {"id": 340000, "name": "ファルファニア中部", "map_no": 340000, "icon_position_x": 1580, "icon_position_y": 540, "is_special": 0, "view_type": 1, "event_title": "ファルファニア咆哮編", "event_description": "緑深き大樹海を往くレイアスたち。\r\n目指すはアルトヘルムの東端、\r\nかつてガナルディアのあった地。", "start_at": "2025-06-23 15:00:00+09:00", "end_at": "None", "status": 1, "area_type": 2}, {"id": 350000, "name": "ファルファニア中部②", "map_no": 350000, "icon_position_x": 1750, "icon_position_y": 620, "is_special": 0, "view_type": 1, "event_title": "ファルファニア月獣編", "event_description": "気づけば周囲の音は消えていた――\r\nあるひとつを除いて消えていた。\r\n月獣が咆哮とともに静寂の森を駆け抜ける。", "start_at": "2025-08-26 15:00:00+09:00", "end_at": "None", "status": 1, "area_type": 2}, {"id": 360000, "name": "ファルファニア東部", "map_no": 360000, "icon_position_x": 2000, "icon_position_y": 600, "is_special": 0, "view_type": 1, "event_title": "ファルファニア楽園編", "event_description": "心は幻日に囚われたまま――\r\n旅人は歩き続けていた。\r\n世界の果ての楽園を目指して。", "start_at": "2025-10-06 15:00:00+09:00", "end_at": "None", "status": 1, "area_type": 2}, {"id": 370000, "name": "ファルファニア中部③", "map_no": 370000, "icon_position_x": 1830, "icon_position_y": 450, "is_special": 0, "view_type": 1, "event_title": "ファルファニア七天編", "event_description": "陽の下を歩く者と影に忍ぶ者。\r\n魔術都市エルハラムに近き山中で\r\n二人の運命は交錯する。", "start_at": "2026-05-29 15:00:00+09:00", "end_at": "None", "status": 1, "area_type": 2}, {"id": 380000, "name": "ファルファニア東部②", "map_no": 380000, "icon_position_x": 2020, "icon_position_y": 400, "is_special": 0, "view_type": 1, "event_title": "ファルファニア閃光編", "event_description": "希望、遺志、絆、約束、未来――\r\nいくつもの出会いの果て、\r\n冒険者は一条の閃光となる。", "start_at": "2026-06-09 15:00:00+09:00", "end_at": "None", "status": 1, "area_type": 2}, {"id": 990000, "name": "異界", "map_no": 990000, "icon_position_x": 0, "icon_position_y": 0, "is_special": 1, "view_type": 1, "event_title": null, "event_description": null, "start_at": "None", "end_at": "None", "status": 1, "area_type": 0}]